# One tick of the world. Installed as a user unit by Hermes (HERMES.md, task 5).
[Unit]
Description=Hegel in Delhi: one tick of the world
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/hegel-in-delhi
ExecStart=/usr/bin/python3 -m world tick
TimeoutStartSec=20min

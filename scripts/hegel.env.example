# Copy to ~/.config/hegel/env on the Pi. Never commit the real file.
PC_MAC=AA:BB:CC:DD:EE:FF        # from Codex, step 7
PC_HOST=192.168.178.50          # the PC's LAN IP, reserved in the router
PC_BCAST=192.168.178.255        # broadcast address of the home network
MIND_PORT=8081                  # Bonsai
QWEN_PORT=8080                  # your Qwen server
HEGEL_PORT=8082                 # Qwen with Hegel's trained adapter (pc/TRAINING.md), for the Hegel test
WATCHDOG_IDLE_MIN=3             # must match the watchdog on the PC

# The world engine (task 5)
HEGEL_BRANCH=shadow             # shadow week; main for the public switch
LEAD_MIN=15                     # publish each step this many minutes before it happens
OWL_AT=01:30                    # when the owl writes up yesterday, Delhi time
OWL_PORT=8081                   # the owl's model; set 8080 once the PC runs the larger model at night
DEPESCHE_DAY=Saturday           # the owl writes the weekly Depesche on this night
# HEGEL_WRITE_MODE=chat         # his writings by the chat call, as before; the default, plain, writes them as a plain-text completion
# HEGEL_PUSH=0                  # write the day files but don't commit or push
# NEWS_FEEDS=https://www.thehindu.com/news/national/feeder/default.rss,https://indianexpress.com/section/india/feed/

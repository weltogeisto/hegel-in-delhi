# Copy to ~/.config/hegel/env on the Pi. Never commit the real file.
PC_MAC=AA:BB:CC:DD:EE:FF        # from Codex, step 7
PC_HOST=192.168.178.50          # the PC's LAN IP, reserved in the router
PC_BCAST=192.168.178.255        # broadcast address of the home network
MIND_PORT=8081                  # Bonsai
QWEN_PORT=8080                  # your Qwen server
WATCHDOG_IDLE_MIN=3             # must match the watchdog on the PC

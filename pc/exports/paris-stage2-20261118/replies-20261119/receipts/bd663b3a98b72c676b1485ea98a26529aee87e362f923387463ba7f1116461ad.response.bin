{"choices":[{"finish_reason":"stop","index":0,"message":{"role":"assistant","content":"Also Brussels! in the house of my friend Mr. van Ghert)) and with a quill that Mde van Ghert has just cut for me, and indeed in a trice, with a single press. — You see hereby that it has become serious, to renounce Paris, — which you, in your letter, which I have just had fetched from the post, — wanted to doubt would happen so soon..."}}],"created":1795080614,"model":"qwen","system_fingerprint":"b11429-d81235049","object":"chat.completion","usage":{"completion_tokens":87,"prompt_tokens":157,"total_tokens":244,"prompt_tokens_details":{"cached_tokens":0}},"id":"chatcmpl-qz19KRbeL1J5XOo8d1E4i4mUzKmYy1A9","timings":{"cache_n":0,"prompt_n":157,"prompt_ms":454.839,"prompt_per_token_ms":2.897063694267516,"prompt_per_second":345.1770846387403,"predicted_n":87,"predicted_ms":2059.505,"predicted_per_token_ms":23.947732558139535,"predicted_per_second":41.757606803576586}}
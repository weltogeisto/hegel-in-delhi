{"choices":[{"finish_reason":"stop","index":0,"message":{"role":"assistant","content":"From Prague I traveled through Bohemia, which is so beautiful in its views—though the Bohemian villages are wretched and no longer seem Bohemian to me now—in the most beautiful, loveliest sunshine, which beautifies everything, just as the full moonlight and a few thin candles now gild my memory of you. Tomorrow at noon I will arrive in Töplitz, and tomorrow evening, perhaps not until Sunday, in Dresden."}}],"created":1795220696,"model":"qwen","system_fingerprint":"b11429-d81235049","object":"chat.completion","usage":{"completion_tokens":94,"prompt_tokens":170,"total_tokens":264,"prompt_tokens_details":{"cached_tokens":0}},"id":"chatcmpl-9EL3CDVU8MMDDbpo6hFDXvmidF4g9D5M","timings":{"cache_n":0,"prompt_n":170,"prompt_ms":349.74,"prompt_per_token_ms":2.057294117647059,"prompt_per_second":486.07537027506146,"predicted_n":94,"predicted_ms":2190.474,"predicted_per_token_ms":23.553483870967742,"predicted_per_second":42.456564195694625}}
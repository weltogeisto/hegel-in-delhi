{"choices":[{"finish_reason":"stop","index":0,"message":{"role":"assistant","content":"It is about eleven o'clock, and it has been a day of petty annoyances. I am too exhausted to write the Lindner letter, and the document is in the hands of the bureaucracy, which goes on at its own rate. I have had a week's supply of dhal, and the heat has at last moderated. I go to sleep."}}],"created":1795129095,"model":"qwen","system_fingerprint":"b11429-d81235049","object":"chat.completion","usage":{"completion_tokens":73,"prompt_tokens":134,"total_tokens":207,"prompt_tokens_details":{"cached_tokens":0}},"id":"chatcmpl-TOTRcHaniMew3DsWG92Jb8kamCTtZqsb","timings":{"cache_n":0,"prompt_n":134,"prompt_ms":775.859,"prompt_per_token_ms":5.7899925373134336,"prompt_per_second":172.7117942822085,"predicted_n":73,"predicted_ms":2196.463,"predicted_per_token_ms":30.506430555555557,"predicted_per_second":32.77997398544842}}
{"choices":[{"finish_reason":"stop","index":0,"message":{"role":"assistant","content":"The night is a great blank, but I am an empty canvas which has been stretched too long. It is smoky, smoky, and dusty, the atmosphere of a brain that has run too long without its wheels. I cannot dine upon an empty air, nor can I purchase from a purse which I have not: so I must allow the sun to go down; the dialectic of hunger and poverty is suspended, not dissolved, till to-morrow."}}],"created":1795128622,"model":"qwen","system_fingerprint":"b11429-d81235049","object":"chat.completion","usage":{"completion_tokens":94,"prompt_tokens":167,"total_tokens":261,"prompt_tokens_details":{"cached_tokens":0}},"id":"chatcmpl-97uDAsWurbfJS9L5Fw1PQXTM8benTqki","timings":{"cache_n":0,"prompt_n":167,"prompt_ms":542.532,"prompt_per_token_ms":3.2486946107784433,"prompt_per_second":307.8159444972831,"predicted_n":94,"predicted_ms":2804.526,"predicted_per_token_ms":30.156193548387094,"predicted_per_second":33.1606838374827}}